	partition Blocks = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("geometry/blocks_wkt.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "area_name", "region_name", "area_m2", "centroid_lat", "centroid_lng", "office_2002", "office_2024", "office_change", "apartments_2002", "apartments_2024", "apartments_change", "hotels_change", "student_change", "total_change", "homes_hotels_students_change", "office_to_living"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"area_name", type text}, {"region_name", type text}, {"area_m2", type number}, {"centroid_lat", type number}, {"centroid_lng", type number}, {"office_2002", type number}, {"office_2024", type number}, {"office_change", type number}, {"apartments_2002", type number}, {"apartments_2024", type number}, {"apartments_change", type number}, {"hotels_change", type number}, {"student_change", type number}, {"total_change", type number}, {"homes_hotels_students_change", type number}, {"office_to_living", Int64.Type}}, "en-AU"),
				    NamesSource = Csv.Document(GetFile("clue/block_names.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Names = Table.TransformColumnTypes(Table.PromoteHeaders(NamesSource, [PromoteAllScalars = true]), {{"block_id", type text}, {"name", type text}}),
				    Joined = Table.NestedJoin(Typed, {"key"}, Names, {"block_id"}, "n", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "n", {"name"}, {"block_name"}),
				    Out = Table.TransformColumns(Expanded, {{"block_name", each if _ = null then "" else _, type text}})
				in
				    Out

	annotation PBI_ResultType = Table
